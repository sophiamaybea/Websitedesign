# Use a long random secret; missing key disables authenticated endpoints.
MEND_API_KEY=replace-with-a-long-random-value
MEND_DB_PATH=/data/mend.sqlite3
MEND_WORKER_POLL_SECONDS=2
MEND_WORKER_LEASE_SECONDS=300
MEND_ENABLE_BROWSER=true
MEND_ENABLE_LAYA=false
# Laya model downloads are substantial; install optional laya separately.
MEND_MAX_AUDIT_REQUESTS=80
# NEVER enable automated production deployment. Customer approval is required.

# Optional OpenAI-compatible web design model (Groq or another provider)
MEND_ENABLE_DESIGN_LLM=false
MEND_DESIGN_API_URL=
MEND_DESIGN_MODEL=
MEND_DESIGN_API_KEY=
MEND_DESIGN_TOKEN_CAP=900

# Optional external coding dispatch; may incur provider charges
MEND_ALLOW_OPENHANDS_DISPATCH=false
MEND_OPENHANDS_API_KEY=
MEND_ALLOWED_CODE_REPOS=
